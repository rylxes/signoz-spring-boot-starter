<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.rylxes</groupId>
        <artifactId>signoz-spring-boot-starter-parent</artifactId>
        <version>1.0.11</version>
    </parent>

    <artifactId>signoz-spring-boot3</artifactId>
    <name>SigNoz Spring Boot 3 Integration</name>

    <properties>
        <!-- SB3 requires Java 17 — override parent's Java 8 source/target -->
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
    </properties>
    <description>
        Spring Boot 3.x auto-configuration and web filters (jakarta.servlet).
        Depends on signoz-core for all business logic.
    </description>

    <dependencyManagement>
        <dependencies>
            <!-- SLF4J 2.x: Spring Boot 3's logback-classic 1.4.x requires LoggingEventAware (SLF4J 2.x API).
                 This direct entry must appear BEFORE the BOM import to override the parent's 1.7.36. -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>2.0.12</version>
            </dependency>

            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot3.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Core module -->
        <dependency>
            <groupId>io.github.rylxes</groupId>
            <artifactId>signoz-core</artifactId>
        </dependency>

        <!-- Spring Boot 3 / Logback 1.4 require the SLF4J 2.x API. -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <version>2.0.12</version>
        </dependency>

        <!-- Spring Boot 3.x autoconfigure (jakarta namespace) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
        </dependency>

        <!-- Spring Web MVC (jakarta.servlet) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring AOP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aop</artifactId>
        </dependency>

        <!-- Logstash Logback Encoder (needed by SigNozJsonEncoder) -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>

        <!-- Spring WebFlux (optional — for WebClient tracing and reactive WebFilters) -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-webflux</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Log4j2 backend support (optional — only used when log4j-core is the logging backend) -->
        <dependency>
            <groupId>org.apache.logging.log4j</groupId>
            <artifactId>log4j-core</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Restores the SigNoz MDC on every Reactor thread hop in WebFlux apps
             (ThreadLocalAccessor + Hooks.enableAutomaticContextPropagation). Tiny, no
             transitive dependencies; inert outside reactive web applications. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
            <version>${context-propagation.version}</version>
        </dependency>

        <!-- Config processor for IDE autocomplete -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Log4j2 as the logging backend, for the log4j2-backend test execution only;
             the default execution keeps Logback by excluding the Log4j2 SLF4J binding. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-log4j2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- spring-boot-starter-web is already in main scope as optional=true,
             which puts it on the compile AND test classpath; no extra test entry needed. -->
        <!-- ReactiveSecurityContextHolder for the reactive user-context tests -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- OTel SDK: used to supply OpenTelemetry.noop() in integration tests -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Test deps: classes named in @ConditionalOnClass for the new protocol auto-configs.
             core declares them as optional, so they are not transitively visible here. -->
        <dependency>
            <groupId>com.amazonaws</groupId>
            <artifactId>aws-java-sdk-sqs</artifactId>
            <version>1.12.692</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-api</artifactId>
            <version>1.62.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-websocket</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-messaging</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- awspring v2 SqsListener — present so SQS aspect bean registers in tests. -->
        <dependency>
            <groupId>io.awspring.cloud</groupId>
            <artifactId>spring-cloud-aws-messaging</artifactId>
            <version>2.4.4</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- Default execution: Logback is the backend. -->
                    <excludes>
                        <exclude>**/*Log4j2BackendTest.java</exclude>
                    </excludes>
                    <classpathDependencyExcludes>
                        <classpathDependencyExclude>org.apache.logging.log4j:log4j-slf4j2-impl</classpathDependencyExclude>
                    </classpathDependencyExcludes>
                </configuration>
                <executions>
                    <!-- Second execution with Log4j2 as the real backend: no Logback, no log4j-to-slf4j. -->
                    <execution>
                        <id>log4j2-backend</id>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <excludes combine.self="override"/>
                            <includes>
                                <include>**/*Log4j2BackendTest.java</include>
                            </includes>
                            <classpathDependencyExcludes combine.self="override">
                                <classpathDependencyExclude>ch.qos.logback:logback-classic</classpathDependencyExclude>
                                <classpathDependencyExclude>ch.qos.logback:logback-core</classpathDependencyExclude>
                                <classpathDependencyExclude>org.apache.logging.log4j:log4j-to-slf4j</classpathDependencyExclude>
                            </classpathDependencyExcludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
